       /* Remember which part of the address space this object uses.  */
-      l->l_map_start = _dl_map_segment (c, mappref, maplength, fd);
+      /* Reserve inaccessible anonymous space.  Do not map non-executable
+         file ranges with the first LOAD's permissions: code-signing kernels
+         can reject that temporary oversized executable mapping.  */
+      ElfW(Addr) align = MAX (c->mapalign, GLRO(dl_pagesize));
+      ElfW(Addr) reserve_len = maplength + align;
+      ElfW(Addr) reserve = (ElfW(Addr)) __mmap ((void *) mappref,
+                            reserve_len, PROT_NONE,
+                            MAP_ANONYMOUS | MAP_COPY, -1, 0);
+      if (__glibc_unlikely ((void *) reserve == MAP_FAILED))
+        return DL_MAP_SEGMENTS_ERROR_MAP_SEGMENT;
+      l->l_map_start = ALIGN_UP (reserve, align);
+      if (l->l_map_start > reserve)
+        __munmap ((void *) reserve, l->l_map_start - reserve);
+      ElfW(Addr) reserve_end = reserve + reserve_len;
+      ElfW(Addr) used_end = ALIGN_UP (l->l_map_start + maplength,
+                                    GLRO(dl_pagesize));
+      if (reserve_end > used_end)
+        __munmap ((void *) used_end, reserve_end - used_end);
       if (__glibc_unlikely ((void *) l->l_map_start == MAP_FAILED))
